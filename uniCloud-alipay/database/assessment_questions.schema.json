function buildQuestions() {
  const result = []

  Object.keys(BANK).forEach(testCode => {
    const config = BANK[testCode]

    config.questions.forEach((item, index) => {
      const question = {
        test_code: testCode,
        question_id: `${testCode}_${String(index + 1).padStart(3, '0')}`,
        title: item[ testCode === 'ability' ? 0 : 2 ],
        question: item[ testCode === 'ability' ? 0 : 2 ],
        dimension: testCode === 'ability' ? item[0] : item[0],
        sort: index + 1,
        difficulty: 'basic',
        status: 1,
        created_at: Date.now()
      }

      if (testCode === 'mbti') {
        question.dimension = item[0]
        question.polarity = item[1]
        question.options = OPTION_TEMPLATES.mbti
      }

      if (testCode === 'holland') {
        question.dimension = item[0]
        question.options = OPTION_TEMPLATES.holland
      }

      if (testCode === 'value') {
        question.dimension = item[0]
        question.options = OPTION_TEMPLATES.value
      }

      if (testCode === 'ability') {
        question.dimension = item[0]
        question.options = item[2].map((label, i) => ({
          value: ['A','B','C','D'][i],
          label
        }))
        question.correct_answer = item[3]
        question.explanation = item[4]
        question.difficulty = 'basic'
      }

      result.push(question)
    })
  })

  return result
}

module.exports = {
  BANK,
  buildQuestions,
  OPTION_TEMPLATES
}
